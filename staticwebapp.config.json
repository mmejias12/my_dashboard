{
  "routes": [
    {
      "route": "/api/conteos-publico",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ],
      "methods": [
        "GET",
        "OPTIONS"
      ]
    },
    {
      "route": "/api/clientes-store",
      "methods": [
        "POST"
      ],
      "allowedRoles": [
        "admin",
        "conteos"
      ]
    },
    {
      "route": "/proxy/ops",
      "rewrite": "/api/ops"
    },
    {
      "route": "/proxy/otconasientos",
      "rewrite": "/api/otconasientos"
    },
    {
      "route": "/admin-uso.html",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/api/analytics-proxy",
      "allowedRoles": [
        "admin"
      ]
    },
    {
      "route": "/login.html",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/login.html"
    },
    {
      "route": "/manifest.json",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/sw.js",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/icons/*",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "platform": {
    "apiRuntime": "node:20"
  },
  "responseOverrides": {
    "401": {
      "redirect": "/login.html",
      "statusCode": 302
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/data/*",
      "/api/*",
      "/images/*",
      "/*.{html,json,xml,txt,ico,png,jpg,jpeg,svg,gif,webp,css,js,map,woff,woff2,ttf,eot}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff"
  }
}
